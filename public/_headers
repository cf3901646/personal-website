# Global security & default zero-cache for all HTML/navigation
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Service Worker & Manifest: Absolutely zero cache to ensure instant updates
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# HTML files across site and sub-paths: Instant revalidation
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/space/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Static immutable hashed assets (vite/rollup): Cached forever since hashes change on rebuild
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/space/assets/*
  Cache-Control: public, max-age=31536000, immutable
