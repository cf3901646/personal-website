---
// src/components/Hero.astro
// 基于 3901646.xyz 专属数学流形程序化生成（纯代码 Canvas 纤维斜阳 ＋ SVG 凹印字槽）
---

<section class="hero-sanctuary" id="hero">
  <!-- 1. 纯代码 SVG 凹印微光学滤镜定义 -->
  <svg class="filter-definitions" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <filter id="pressed-ink" x="-10%" y="-30%" width="120%" height="170%" color-interpolation-filters="sRGB">
        <!-- 字槽下沿接光，内侧的上沿落下细小阴影 -->
        <feGaussianBlur in="SourceAlpha" stdDeviation=".4" result="soft-alpha" />
        <feOffset in="soft-alpha" dx=".35" dy="1.3" result="lower-edge" />
        <feComposite in="lower-edge" in2="SourceAlpha" operator="out" result="rim" />
        <feFlood flood-color="#fffae9" flood-opacity=".95" />
        <feComposite in2="rim" operator="in" result="lit-rim" />
        <feOffset in="SourceAlpha" dx=".6" dy="1.05" result="shifted" />
        <feComposite in="SourceAlpha" in2="shifted" operator="out" result="inset-edge" />
        <feGaussianBlur in="inset-edge" stdDeviation=".35" result="inset-soft" />
        <feFlood flood-color="#6e553c" flood-opacity=".8" />
        <feComposite in2="inset-soft" operator="in" result="inset-shadow" />
        <feMerge>
          <feMergeNode in="lit-rim" />
          <feMergeNode in="SourceGraphic" />
          <feMergeNode in="inset-shadow" />
        </feMerge>
      </filter>
    </defs>
  </svg>

  <!-- 2. 日光与多尺度纸张纤维纯代码画布 -->
  <div class="paper-stage">
    <canvas id="surface" aria-hidden="true"></canvas>

    <!-- 3. 中央活字压印邮箱核心标题 -->
    <div class="letterpress-wrap" id="letterpress-wrap">
      <h1>
        <button
          type="button"
          class="letterpress-btn"
          id="email-btn"
          aria-label="点击复制邮箱 cf3901646@gmail.com"
          title="点击拓印复制 cf3901646@gmail.com"
        >
          cf3901646@gmail.com
        </button>
      </h1>

      <div class="copy-whisper" id="copy-whisper" role="status" aria-live="polite">
        已拓印至剪贴板 · 3901646.xyz
      </div>
    </div>

    <!-- 4. 底部微弱呼吸导引 -->
    <a href="#sanctuary-content" class="scroll-whisper" aria-label="向下滚动阅读">
      <span class="scroll-line"></span>
    </a>
  </div>
</section>

<style>
  .hero-sanctuary {
    position: relative;
    width: 100vw;
    height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #ded7c6;
    isolation: isolate;
  }

  .filter-definitions {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .paper-stage {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    min-height: 100svh;
    isolation: isolate;
    background:
      radial-gradient(ellipse at 65% 30%, #fff7df99, transparent 60%),
      linear-gradient(143deg, #d4cebf, #eee8d5 52%, #d9d1c0);
  }

  .paper-stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .paper-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse at 50% 50%, transparent 36%, #9a8b6d0b 100%);
  }

  .letterpress-wrap {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    user-select: none;
    will-change: transform, opacity;
  }

  h1 {
    margin: 0;
    font-size: inherit;
    font-weight: normal;
  }

  .letterpress-btn {
    display: block;
    background: none;
    border: none;
    padding: 0.5rem 1rem;
    cursor: pointer;
    font-family: "Times New Roman", "Baskerville", "Cormorant Garamond", serif;
    font-size: clamp(26px, 4.8vw, 96px);
    font-weight: 400;
    font-kerning: normal;
    line-height: 1.15;
    letter-spacing: .006em;
    white-space: nowrap;
    text-decoration: none;
    color: #b6a48b;
    background: linear-gradient(102deg,
      #c9bfaa 0%, #d9c5a4 12%, #e4c292 24%, #e4c69b 43%,
      #cdbca0 54%, #d5c7af 75%, #cbbfa9 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: url(#pressed-ink);
    transform: translateY(1px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
    outline: none;
  }

  .letterpress-btn:hover {
    transform: translateY(-1px);
    filter: url(#pressed-ink) drop-shadow(0 0 12px rgba(228, 194, 146, 0.45));
  }

  .letterpress-btn:active {
    transform: translateY(2px) scale(0.995);
  }

  .letterpress-btn:focus-visible {
    outline: 1px solid #8a795f;
    outline-offset: 12px;
    border-radius: 2px;
  }

  .copy-whisper {
    margin-top: 1rem;
    font-family: 'Noto Serif SC', 'Times New Roman', serif;
    font-size: 0.82rem;
    letter-spacing: 0.22em;
    color: rgba(135, 110, 78, 0);
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.7);
    transition: color 0.5s ease, transform 0.5s ease;
    transform: translateY(6px);
    pointer-events: none;
  }

  :global(.copy-whisper.visible) {
    color: rgba(135, 110, 78, 0.95) !important;
    transform: translateY(0) !important;
  }

  /* 底部向下呼吸标 */
  .scroll-whisper {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.45;
    transition: opacity 0.4s ease;
    cursor: pointer;
    text-decoration: none;
  }

  .scroll-whisper:hover {
    opacity: 0.9;
  }

  .scroll-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(to bottom, rgba(120, 105, 82, 0.8), transparent);
    animation: scrollPulse 3.5s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(0.85); opacity: 0.45; }
    50% { transform: scaleY(1.15); opacity: 1; }
  }

  @media (max-width: 600px) {
    .letterpress-btn {
      font-size: 7.3vw;
      letter-spacing: -.035em;
    }
  }

  @media (forced-colors: active) {
    .letterpress-btn {
      background: none;
      -webkit-text-fill-color: LinkText;
      filter: none;
    }
  }
</style>

<script>
  // 1. 点击拓印复制邮箱
  const emailBtn = document.getElementById('email-btn');
  const copyWhisper = document.getElementById('copy-whisper');
  let whisperTimer: number | undefined;

  emailBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('cf3901646@gmail.com');
    } catch (_) {
      const area = document.createElement('textarea');
      area.value = 'cf3901646@gmail.com';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      document.body.removeChild(area);
    }
    copyWhisper?.classList.add('visible');
    if (whisperTimer) clearTimeout(whisperTimer);
    whisperTimer = window.setTimeout(() => {
      copyWhisper?.classList.remove('visible');
    }, 2400);
  });

  // 2. 3901646 专属程序化高保真日光、纸张与树影引擎
  (() => {
    const settings = { grain: 1, shadow: .62 };
    const W = 1376, H = 768;
    const canvas = document.querySelector('#surface') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d', { alpha: false });
    if (!ctx) return;

    function random(seed: number) {
      return () => {
        seed |= 0; seed = seed + 0x6D2B79F5 | 0;
        let n = Math.imul(seed ^ seed >>> 15, 1 | seed);
        n = n + Math.imul(n ^ n >>> 7, 61 | n) ^ n;
        return ((n ^ n >>> 14) >>> 0) / 4294967296;
      };
    }

    function layer(w = W, h = H) {
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      return c;
    }

    function noiseField(cell: number, rng: () => number) {
      const columns = Math.ceil(W / cell) + 2;
      const rows = Math.ceil(H / cell) + 2;
      const values = Float32Array.from({ length: columns * rows }, () => rng() * 2 - 1);
      return (x: number, y: number) => {
        const gx = x / cell, gy = y / cell;
        const ix = Math.floor(gx), iy = Math.floor(gy);
        let u = gx - ix, v = gy - iy;
        u = u * u * (3 - 2 * u); v = v * v * (3 - 2 * v);
        const i = iy * columns + ix;
        return (values[i] * (1 - u) + values[i + 1] * u) * (1 - v)
          + (values[i + columns] * (1 - u) + values[i + columns + 1] * u) * v;
      };
    }

    // 多尺度的随机纤维与色斑烘焙一次 (使用专属种子 3901646)
    const paper = layer();
    const p = paper.getContext('2d')!;
    const pixels = p.createImageData(W, H);
    const rng = random(3901646);
    const cloud = noiseField(125, rng);
    const pulp = noiseField(22, rng);
    const fiber = noiseField(3, rng);
    for (let y = 0; y < H; y++) {
      for (let x = 0; x < W; x++) {
        const cross = x * .56 + y * .83;
        const beam = Math.exp(-Math.pow((cross - 650) / 230, 2));
        const ribbons = Math.sin(cross / 21 + cloud(x, y) * .8 + x / 650)
          * 5.5 + Math.sin(cross / 43 + x / 300) * 4;
        const light = beam * (28 + ribbons);
        const tooth = ((rng() + rng() - 1) * 5.5 + fiber(x, y) * 2.4
          + pulp(x, y) * 1.6) * settings.grain;
        const shade = cloud(x, y) * 3.5 + tooth;
        const i = (y * W + x) * 4;
        pixels.data[i] = 219 + light + shade;
        pixels.data[i + 1] = 213 + light + shade;
        pixels.data[i + 2] = 196 + light * .94 + shade;
        pixels.data[i + 3] = 255;
      }
    }
    p.putImageData(pixels, 0, 0);

    // 稀疏、细碎的纸浆纤维
    const fleckRng = random(160);
    for (let i = 0; i < 15500; i++) {
      const x = fleckRng() * W, y = fleckRng() * H;
      const length = .3 + fleckRng() * 2.2;
      p.strokeStyle = fleckRng() > .5 ? 'rgba(112,91,60,.055)' : 'rgba(255,253,228,.16)';
      p.lineWidth = .3 + fleckRng() * .5;
      p.beginPath(); p.moveTo(x, y);
      p.lineTo(x + length, y - fleckRng() * 1.2); p.stroke();
    }

    const shade = layer();
    const s = shade.getContext('2d')!;
    const leavesRng = random(27);

    function leaf(x: number, y: number, length: number, width: number, angle: number, opacity: number) {
      s.save();
      s.translate(x, y); s.rotate(angle);
      s.fillStyle = `rgba(72,73,52,${opacity})`;
      s.beginPath(); s.moveTo(0, 0);
      s.bezierCurveTo(length * .28, -width * .7, length * .72, -width * .65, length, 0);
      s.bezierCurveTo(length * .68, width * .42, length * .22, width * .7, 0, 0);
      s.fill(); s.restore();
    }

    // 斜射光把枝叶的影子拉长
    const branches = [
      [1410, -80, 940, 510, 20],
      [1230, -105, 810, 480, 20],
      [1110, -120, 640, 480, 16],
      [1520, 40, 1130, 490, 18],
      [1310, -120, 980, 380, 19],
      [1480, -60, 1070, 400, 18]
    ];
    for (const [x0, y0, x1, y1, count] of branches) {
      s.beginPath(); s.moveTo(x0, y0);
      s.quadraticCurveTo(x0 - 150, y1 * .56, x1, y1);
      s.strokeStyle = 'rgba(68,69,51,.18)'; s.lineWidth = 9;
      s.lineCap = 'round'; s.stroke();
      for (let i = 0; i < count; i++) {
        const t = (i + .3 + leavesRng() * .6) / count;
        const q = 1 - t;
        const x = q * q * x0 + 2 * q * t * (x0 - 150) + t * t * x1;
        const y = q * q * y0 + 2 * q * t * (y1 * .56) + t * t * y1;
        const side = i % 2 === 0 ? 1 : -1;
        const angle = side > 0 ? -.92 + leavesRng() * .5 : 2.28 + leavesRng() * .45;
        leaf(x + (leavesRng() - .5) * 40, y, 65 + leavesRng() * 150, 12 + leavesRng() * 26,
          angle, (.14 + leavesRng() * .20) * (1 - t * .60));
      }
    }

    const scene = layer();
    const c = scene.getContext('2d')!;
    c.drawImage(paper, 0, 0);
    c.save();
    c.filter = 'blur(7px)';
    c.globalAlpha = settings.shadow;
    c.drawImage(shade, 0, 0);
    c.restore();

    // 更远处的枝叶在左下形成宽而散的影子
    c.save();
    c.filter = 'blur(19px)';
    c.lineCap = 'round';
    const distant = [
      [-90, 775, 370, 625, 790, 180, 28, .20],
      [90, 860, 490, 555, 1010, 125, 30, .24],
      [420, 875, 695, 615, 1240, 205, 36, .25],
      [640, 900, 860, 610, 1300, 400, 25, .16],
      [130, 785, 300, 670, 380, 580, 55, .11]
    ];
    for (const [x, y, cx, cy, ex, ey, width, alpha] of distant) {
      c.strokeStyle = `rgba(92,88,64,${alpha * settings.shadow})`;
      c.lineWidth = width;
      c.beginPath(); c.moveTo(x, y); c.quadraticCurveTo(cx, cy, ex, ey); c.stroke();
    }
    c.restore();

    // 日光中极少量的亮尘
    const dust = random(18);
    for (let i = 0; i < 26; i++) {
      const x = 190 + dust() * 430, y = 120 + dust() * 520;
      const r = .45 + dust() * 1.45;
      c.beginPath();
      c.fillStyle = `rgba(255,244,195,${.3 + dust() * .45})`;
      c.shadowColor = '#fff5d0'; c.shadowBlur = 3;
      c.ellipse(x, y, r, r * .72, -.5, 0, Math.PI * 2); c.fill();
    }
    c.shadowBlur = 0;

    function render() {
      if (!canvas || !ctx) return;
      const width = window.innerWidth, height = window.innerHeight;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const scale = Math.max(width / W, height / H);
      const left = (width - W * scale) / 2;
      const top = (height - H * scale) / 2;
      ctx.drawImage(scene, left, top, W * scale, H * scale);
    }

    let frame: number;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(render);
    }, { passive: true });
    render();
  })();
</script>
