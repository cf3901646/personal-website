---
// src/components/Hero.astro
// 高保真摄影级实景光影 ＋ SVG 动态法线活字凹印
---

<section class="hero-sanctuary" id="hero">
  <!-- 1. 真实摄影级斜阳树影基底层 -->
  <div class="hero-bg-frame" id="hero-bg-frame" aria-hidden="true">
    <img
      src="/hero-bg-clean.webp"
      alt=""
      class="hero-bg-photo"
      id="hero-bg-img"
      loading="eager"
      decoding="async"
    />
  </div>

  <!-- 2. 悬浮金尘粒子层 -->
  <canvas id="dust-canvas" aria-hidden="true"></canvas>

  <!-- 3. 中央高保真活字凹印舞台 -->
  <div class="letterpress-stage" id="letterpress-stage">
    <button
      type="button"
      class="email-press-btn"
      id="email-btn"
      aria-label="复制邮箱 cf3901646@gmail.com"
      title="点击拓印复制 cf3901646@gmail.com"
    >
      <svg
        class="deboss-svg"
        viewBox="0 0 920 180"
        xmlns="http://www.w3.org/2000/svg"
        id="deboss-svg"
      >
        <defs>
          <!-- 核心：负 surfaceScale 凹印光学法线滤镜 -->
          <filter id="blind-deboss" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="linearRGB">
            <!-- 1. 边缘斜坡高度场 (Bevel Ramp) -->
            <feGaussianBlur in="SourceAlpha" stdDeviation="1.5" result="blurredAlpha" />

            <!-- 2. 漫反射下凹受光 (负 surfaceScale 让法线向内反折实现下凹) -->
            <feDiffuseLighting in="blurredAlpha" surfaceScale="-4.2" diffuseConstant="1.25" lighting-color="#ffffff" result="diffuseBump">
              <fePointLight id="pl-deboss" x="460" y="90" z="65" />
            </feDiffuseLighting>

            <!-- 3. 镜面柔焦微高光 (Specular Rim Highlight) -->
            <feSpecularLighting in="blurredAlpha" surfaceScale="-3.2" specularConstant="0.45" specularExponent="16" lighting-color="#fff8ea" result="specularBump">
              <fePointLight id="pl-specular" x="460" y="90" z="65" />
            </feSpecularLighting>

            <!-- 4. 组合漫反射与文字 Alpha -->
            <feComposite in="diffuseBump" in2="SourceAlpha" operator="in" result="litDeboss" />
            <feBlend in="litDeboss" in2="specularBump" mode="screen" result="shadedDeboss" />

            <!-- 5. 凹陷深处微调暗 (Cavity Compaction) -->
            <feColorMatrix in="SourceAlpha" type="matrix"
              values="0 0 0 0 0.18
                      0 0 0 0 0.16
                      0 0 0 0 0.13
                      0 0 0 0 0.12 0" result="cavityTone" />

            <feMerge>
              <feMergeNode in="cavityTone" />
              <feMergeNode in="shadedDeboss" />
            </feMerge>
          </filter>

          <!-- 同源数字 3901646 琥珀金微光渐变 -->
          <linearGradient id="amber-sunlit-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#dfa45c" />
            <stop offset="50%" stop-color="#c98e4d" />
            <stop offset="100%" stop-color="#b87b38" />
          </linearGradient>

          <!-- 琥珀微光滤镜 -->
          <filter id="amber-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3.5" result="glow" />
            <feComposite in="SourceGraphic" in2="glow" operator="over" />
          </filter>
        </defs>

        <!-- 活字压印文字编排 -->
        <g class="letterpress-group">
          <!-- 前缀 cf -->
          <text
            x="85"
            y="112"
            font-family="'Cormorant Garamond', Georgia, serif"
            font-size="64"
            font-weight="400"
            letter-spacing="2"
            fill="#ede6d8"
            filter="url(#blind-deboss)"
          >cf</text>

          <!-- 核心同源数字 3901646（受斜阳照耀的琥珀金光芒） -->
          <text
            x="148"
            y="112"
            font-family="'Cormorant Garamond', Georgia, serif"
            font-size="64"
            font-weight="500"
            letter-spacing="3"
            fill="url(#amber-sunlit-grad)"
            filter="url(#blind-deboss)"
            class="sunlit-digits"
          >3901646</text>

          <!-- 后缀 @gmail.com -->
          <text
            x="455"
            y="112"
            font-family="'Cormorant Garamond', Georgia, serif"
            font-size="64"
            font-weight="400"
            letter-spacing="2"
            fill="#ede6d8"
            filter="url(#blind-deboss)"
          >@gmail.com</text>
        </g>
      </svg>
    </button>

    <div class="copy-whisper" id="copy-whisper" role="status" aria-live="polite">
      已拓印至剪贴板 · 3901646.xyz
    </div>
  </div>

  <!-- 底部呼吸导引线 -->
  <a href="#sanctuary-content" class="scroll-whisper" aria-label="向下滚动阅读">
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero-sanctuary {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #f5f2ea;
  }

  /* 摄影级斜阳树影真实底图层 */
  .hero-bg-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .hero-bg-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.02);
    transform-origin: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    animation: gentleBreeze 16s ease-in-out infinite alternate;
  }

  @keyframes gentleBreeze {
    0% {
      transform: scale(1.02) translate(0, 0);
    }
    100% {
      transform: scale(1.035) translate(4px, -3px);
    }
  }

  /* 悬浮金尘粒子画布 */
  #dust-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }

  /* 活字压印交互舞台 */
  .letterpress-stage {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    user-select: none;
  }

  .email-press-btn {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
  }

  .email-press-btn:hover {
    transform: translateY(-2px);
  }

  .email-press-btn:hover .sunlit-digits {
    filter: drop-shadow(0 0 8px rgba(228, 160, 76, 0.55));
  }

  .email-press-btn:active {
    transform: translateY(1px) scale(0.995);
  }

  .deboss-svg {
    width: clamp(340px, 68vw, 880px);
    height: auto;
    display: block;
    overflow: visible;
  }

  .sunlit-digits {
    transition: filter 0.4s ease;
  }

  /* 拓印成功提示 */
  .copy-whisper {
    margin-top: 1rem;
    font-family: 'Noto Serif SC', 'Cormorant Garamond', Georgia, serif;
    font-size: 0.82rem;
    letter-spacing: 0.24em;
    color: rgba(145, 118, 80, 0);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
    transition: color 0.5s ease, transform 0.5s ease;
    transform: translateY(6px);
    pointer-events: none;
  }

  :global(.copy-whisper.visible) {
    color: rgba(145, 118, 80, 0.95) !important;
    transform: translateY(0) !important;
  }

  /* 底部向下呼吸标 */
  .scroll-whisper {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.45;
    transition: opacity 0.4s ease;
    cursor: pointer;
    text-decoration: none;
  }

  .scroll-whisper:hover {
    opacity: 0.9;
  }

  .scroll-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(to bottom, rgba(120, 105, 82, 0.8), transparent);
    animation: scrollPulse 3.5s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(0.85); opacity: 0.45; }
    50% { transform: scaleY(1.15); opacity: 1; }
  }
</style>

<script>
  // 1. 光标三维点光源与 SVG 活字凹印滤镜光学联动 (Optical Relighting)
  const svg = document.getElementById('deboss-svg');
  const lightDiffuse = document.getElementById('pl-deboss');
  const lightSpecular = document.getElementById('pl-specular');
  const bgImg = document.getElementById('hero-bg-img');

  window.addEventListener('pointermove', (e) => {
    if (!svg || !lightDiffuse || !lightSpecular) return;
    const rect = svg.getBoundingClientRect();

    // 映射到 SVG 920x180 坐标系
    const svgX = ((e.clientX - rect.left) / rect.width) * 920;
    const svgY = ((e.clientY - rect.top) / rect.height) * 180;

    lightDiffuse.setAttribute('x', svgX.toFixed(1));
    lightDiffuse.setAttribute('y', svgY.toFixed(1));
    lightSpecular.setAttribute('x', svgX.toFixed(1));
    lightSpecular.setAttribute('y', svgY.toFixed(1));

    // 背景树影微视差联动
    if (bgImg) {
      const nx = (e.clientX / window.innerWidth) - 0.5;
      const ny = (e.clientY / window.innerHeight) - 0.5;
      bgImg.style.transform = `scale(1.03) translate(${(nx * -12).toFixed(1)}px, ${(ny * -8).toFixed(1)}px)`;
    }
  }, { passive: true });

  // 2. 点击拓印复制邮箱
  const emailBtn = document.getElementById('email-btn');
  const copyWhisper = document.getElementById('copy-whisper');
  let whisperTimer: number | undefined;

  emailBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('cf3901646@gmail.com');
    } catch (_) {
      const area = document.createElement('textarea');
      area.value = 'cf3901646@gmail.com';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      document.body.removeChild(area);
    }
    copyWhisper?.classList.add('visible');
    if (whisperTimer) clearTimeout(whisperTimer);
    whisperTimer = window.setTimeout(() => {
      copyWhisper?.classList.remove('visible');
    }, 2400);
  });

  // 3. 丁达尔浮尘粒子系统
  const canvas = document.getElementById('dust-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    const DUST_COUNT = 32;
    const motes = Array.from({ length: DUST_COUNT }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      r: 0.6 + Math.random() * 1.5,
      vx: 0.08 + Math.random() * 0.18,
      vy: -0.06 - Math.random() * 0.14,
      phase: Math.random() * Math.PI * 2,
      speed: 0.008 + Math.random() * 0.015
    }));

    function renderDust() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      for (const m of motes) {
        m.x += m.vx;
        m.y += m.vy;
        m.phase += m.speed;

        if (m.x > width + 10) m.x = -10;
        if (m.y < -10) m.y = height + 10;

        // 斜阳对角线光锥通道
        const diagDist = Math.abs((m.x / width) + (m.y / height) - 1.02);
        const sunFactor = Math.max(0.1, 1 - diagDist * 2.0);
        const alpha = (0.22 + 0.52 * Math.sin(m.phase)) * sunFactor;

        if (alpha > 0.05) {
          ctx.beginPath();
          ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 242, 210, ${alpha.toFixed(3)})`;
          ctx.shadowColor = 'rgba(235, 175, 85, 0.55)';
          ctx.shadowBlur = 6;
          ctx.fill();
        }
      }
      requestAnimationFrame(renderDust);
    }
    renderDust();
  }
</script>
