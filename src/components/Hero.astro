---
// src/components/Hero.astro
// 首屏：1:1 物理复刻「午后斜阳 · 活字压痕 cf3901646@gmail.com」
---

<section class="hero-sanctuary" id="hero">
  <div class="sunbeam-layer" id="sunbeam" aria-hidden="true"></div>
  <div class="gobo-dapple" id="gobo" aria-hidden="true"></div>
  <canvas id="dust-canvas" aria-hidden="true"></canvas>

  <div class="letterpress-stage" id="letterpress-stage">
    <button
      type="button"
      class="email-imprint"
      id="email-btn"
      aria-label="复制邮箱 cf3901646@gmail.com"
      title="点击拓印复制 cf3901646@gmail.com"
    ><span class="part-muted">cf</span><span class="part-sunlit">3901646</span><span class="part-muted">@gmail.com</span></button>
    <div class="copy-whisper" id="copy-whisper" role="status" aria-live="polite">
      已拓印至剪贴板 · 3901646.xyz
    </div>
  </div>

  <a href="#sanctuary-content" class="scroll-whisper" aria-label="向下滚动阅读">
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero-sanctuary {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(ellipse 95% 85% at 60% 36%, var(--paper-warm) 0%, var(--paper-base) 65%, #dcd3c0 100%);
    will-change: opacity, transform;
  }

  /* 1. 斜阳主光束层（加色滤镜，3200K 暖金入射） */
  .sunbeam-layer {
    position: absolute;
    inset: -20%;
    pointer-events: none;
    z-index: 2;
    transform: translate3d(var(--sun-shift-x), var(--sun-shift-y), 0) rotate(-32deg);
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(215, 204, 186, 0.12) 26%,
      var(--sun-glow) 41%,
      var(--sun-core) 50%,
      var(--sun-glow) 59%,
      transparent 75%
    );
    filter: blur(20px);
    mix-blend-mode: soft-light;
    animation: sunbeamBreeze 15s ease-in-out infinite alternate;
  }

  /* 2. 真实窗景与枝叶斑驳树影（Gobo 遮蔽层，大光圈柔和弥散） */
  .gobo-dapple {
    position: absolute;
    inset: -15%;
    pointer-events: none;
    z-index: 3;
    transform: translate3d(calc(var(--sun-shift-x) * 1.35), calc(var(--sun-shift-y) * 1.35), 0);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.74;
    mix-blend-mode: multiply;
    background-image:
      radial-gradient(ellipse 340px 95px at 68% 22%, rgba(255, 250, 238, 0.95) 0%, transparent 72%),
      radial-gradient(ellipse 270px 80px at 53% 45%, rgba(255, 248, 232, 0.98) 0%, transparent 74%),
      radial-gradient(ellipse 390px 115px at 36% 68%, rgba(255, 246, 225, 0.85) 0%, transparent 75%),
      radial-gradient(circle 50px at 73% 30%, rgba(142, 126, 102, 0.42) 0%, transparent 80%),
      radial-gradient(circle 70px at 62% 49%, rgba(142, 126, 102, 0.38) 0%, transparent 82%),
      radial-gradient(circle 60px at 70% 58%, rgba(142, 126, 102, 0.34) 0%, transparent 78%),
      radial-gradient(circle 42px at 56% 35%, rgba(142, 126, 102, 0.32) 0%, transparent 75%);
    filter: blur(14px);
    animation: leavesSway 12s ease-in-out infinite alternate;
  }

  @keyframes sunbeamBreeze {
    0% { transform: translate3d(var(--sun-shift-x), var(--sun-shift-y), 0) rotate(-32deg) scale(1); }
    100% { transform: translate3d(calc(var(--sun-shift-x) + 15px), calc(var(--sun-shift-y) - 8px), 0) rotate(-30.5deg) scale(1.025); }
  }

  @keyframes leavesSway {
    0% { transform: translate3d(calc(var(--sun-shift-x) * 1.35), calc(var(--sun-shift-y) * 1.35), 0) scale(1); }
    100% { transform: translate3d(calc(var(--sun-shift-x) * 1.35 - 16px), calc(var(--sun-shift-y) * 1.35 + 10px), 0) scale(1.035); }
  }

  /* 3. 悬浮金色微尘粒子画布 */
  #dust-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 4;
  }

  /* 4. 首屏唯一视觉重心：纯净活字凹印邮箱 */
  .letterpress-stage {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 3rem;
    user-select: none;
    will-change: transform, opacity;
  }

  .email-imprint {
    position: relative;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2rem, 4.6vw, 3.85rem);
    font-weight: 500;
    letter-spacing: 0.03em;
    line-height: 1.2;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.4em 0.6em;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
  }

  .email-imprint .part-muted {
    color: rgba(180, 168, 149, 0.75);
    text-shadow:
      var(--light-dir-x) var(--light-dir-y) 1.5px rgba(98, 84, 65, 0.52),
      var(--highlight-x) var(--highlight-y) 2px rgba(255, 252, 245, 0.92),
      0 0 1px rgba(125, 112, 92, 0.22);
    transition: color 0.5s ease, text-shadow 0.5s ease;
  }

  .email-imprint .part-sunlit {
    position: relative;
    color: rgba(208, 158, 96, 0.9);
    text-shadow:
      var(--light-dir-x) var(--light-dir-y) 1.5px rgba(108, 74, 32, 0.68),
      var(--highlight-x) var(--highlight-y) 2.5px rgba(255, 250, 235, 1.0),
      0 0 16px var(--amber-glow);
    transition: color 0.5s ease, text-shadow 0.5s ease;
  }

  .email-imprint:hover {
    transform: translateY(-1.5px);
  }

  .email-imprint:hover .part-muted {
    color: rgba(162, 144, 120, 0.92);
    text-shadow:
      var(--light-dir-x) var(--light-dir-y) 1.8px rgba(88, 74, 55, 0.62),
      var(--highlight-x) var(--highlight-y) 2.4px rgba(255, 253, 248, 0.98);
  }

  .email-imprint:hover .part-sunlit {
    color: rgba(218, 154, 76, 1.0);
    text-shadow:
      var(--light-dir-x) var(--light-dir-y) 1.8px rgba(98, 62, 22, 0.78),
      var(--highlight-x) var(--highlight-y) 3px rgba(255, 252, 238, 1.0),
      0 0 24px rgba(236, 175, 90, 0.52);
  }

  .email-imprint:active {
    transform: translateY(0.5px) scale(0.995);
  }

  .copy-whisper {
    margin-top: 0.85rem;
    font-family: 'Noto Serif SC', 'Cormorant Garamond', serif;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    color: rgba(135, 110, 78, 0);
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.7);
    transition: color 0.5s ease, transform 0.5s ease;
    transform: translateY(4px);
    pointer-events: none;
  }

  :global(.copy-whisper.visible) {
    color: rgba(135, 110, 78, 0.82) !important;
    transform: translateY(0) !important;
  }

  .scroll-whisper {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.38;
    transition: opacity 0.4s ease;
    cursor: pointer;
    text-decoration: none;
  }

  .scroll-whisper:hover {
    opacity: 0.78;
  }

  .scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, rgba(132, 116, 92, 0.7), transparent);
    box-shadow: 1px 0 0 rgba(255, 252, 244, 0.65);
    animation: scrollPulse 3.2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { transform: scaleY(0.85); opacity: 0.42; }
    50% { transform: scaleY(1.12); opacity: 0.92; }
  }

  @media (max-width: 640px) {
    .letterpress-stage {
      padding: 1rem;
    }
  }
</style>

<script>
  // 1. 光标移动与首屏斜阳活字压痕物理光学联动
  const root = document.documentElement;
  window.addEventListener('pointermove', (e) => {
    const nx = (e.clientX / window.innerWidth) - 0.5;
    const ny = (e.clientY / window.innerHeight) - 0.5;

    const shadowX = (-1.1 - nx * 1.3).toFixed(2) + 'px';
    const shadowY = (-1.5 - ny * 1.3).toFixed(2) + 'px';
    const hiX = (1.4 + nx * 1.3).toFixed(2) + 'px';
    const hiY = (2.0 + ny * 1.3).toFixed(2) + 'px';

    root.style.setProperty('--light-dir-x', shadowX);
    root.style.setProperty('--light-dir-y', shadowY);
    root.style.setProperty('--highlight-x', hiX);
    root.style.setProperty('--highlight-y', hiY);

    root.style.setProperty('--sun-shift-x', (nx * -20).toFixed(1) + 'px');
    root.style.setProperty('--sun-shift-y', (ny * -14).toFixed(1) + 'px');
  }, { passive: true });

  // 2. 点击邮箱拓印复制
  const emailBtn = document.getElementById('email-btn');
  const copyWhisper = document.getElementById('copy-whisper');
  let whisperTimer: number | undefined;

  emailBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('cf3901646@gmail.com');
    } catch (_) {
      const area = document.createElement('textarea');
      area.value = 'cf3901646@gmail.com';
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      document.body.removeChild(area);
    }
    copyWhisper?.classList.add('visible');
    if (whisperTimer) clearTimeout(whisperTimer);
    whisperTimer = window.setTimeout(() => {
      copyWhisper?.classList.remove('visible');
    }, 2400);
  });

  // 3. 悬浮金尘粒子系统
  const canvas = document.getElementById('dust-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      if (!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    }, { passive: true });

    const DUST_COUNT = 28;
    const motes = Array.from({ length: DUST_COUNT }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      r: 0.65 + Math.random() * 1.45,
      vx: 0.07 + Math.random() * 0.16,
      vy: -0.05 - Math.random() * 0.13,
      phase: Math.random() * Math.PI * 2,
      speed: 0.007 + Math.random() * 0.014
    }));

    function renderDust() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);
      for (const m of motes) {
        m.x += m.vx;
        m.y += m.vy;
        m.phase += m.speed;

        if (m.x > width + 10) m.x = -10;
        if (m.y < -10) m.y = height + 10;

        const diagDist = Math.abs((m.x / width) + (m.y / height) - 1.02);
        const sunFactor = Math.max(0.08, 1 - diagDist * 2.1);
        const alpha = (0.2 + 0.48 * Math.sin(m.phase)) * sunFactor;

        if (alpha > 0.04) {
          ctx.beginPath();
          ctx.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 238, 194, ${alpha.toFixed(3)})`;
          ctx.shadowColor = 'rgba(232, 175, 96, 0.45)';
          ctx.shadowBlur = 5;
          ctx.fill();
        }
      }
      requestAnimationFrame(renderDust);
    }
    renderDust();
  }
</script>
