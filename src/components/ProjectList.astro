---
// src/components/ProjectList.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="projects-section" id="projects">
  <div class="section-eyebrow">
    <span>Craft & Code</span>
    <span class="index">02 / Creations</span>
  </div>

  <div class="projects-stream">
    {projects.map((project) => (
      <div class="project-item" data-project={project.data.index}>
        <div class="project-header">
          <div class="project-title-group">
            <span class="project-index">{project.data.index}</span>
            <h3 class="project-title">{project.data.title}</h3>
          </div>
          <span class="project-year">{project.data.year}</span>
        </div>
        <p class="project-summary">{project.data.description}</p>
        <div class="project-drawer">
          <div class="project-tags">
            {project.data.tags.map((tag) => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
          <div class="project-links">
            {project.data.github && (
              <a class="project-link" href={project.data.github} target="_blank" rel="noopener">GitHub 仓库 ↗</a>
            )}
            {project.data.demo && (
              <a class="project-link" href={project.data.demo} target="_blank" rel="noopener">在线体验 ↗</a>
            )}
            {project.data.articleUrl && (
              <a class="project-link" href={project.data.articleUrl}>设计手记 →</a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .section-eyebrow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-whisper);
  }

  .section-eyebrow .index {
    color: var(--amber-rim);
    font-weight: 400;
  }

  .projects-stream {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }

  .project-item {
    position: relative;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--paper-crease);
    box-shadow: 0 1px 0 var(--paper-highlight);
  }

  .project-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    cursor: pointer;
  }

  .project-title-group {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
  }

  .project-index {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    color: var(--ink-whisper);
    letter-spacing: 0.1em;
    transition: color 0.3s ease;
  }

  .project-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 2.7vw, 2.15rem);
    font-weight: 500;
    color: var(--ink-deep);
    letter-spacing: 0.01em;
    transition: color 0.3s ease;
  }

  .project-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--ink-whisper);
  }

  .project-summary {
    margin-top: 0.65rem;
    margin-left: 2.25rem;
    font-size: 0.98rem;
    color: var(--ink-body);
    line-height: 1.72;
  }

  .project-drawer {
    margin-left: 2.25rem;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(-6px);
    transition: max-height 0.65s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.5s ease,
                transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                margin-top 0.4s ease;
  }

  :global(.project-item.is-unfolded) .project-drawer,
  .project-item:hover .project-drawer {
    max-height: 190px;
    opacity: 1;
    transform: translateY(0);
    margin-top: 1.25rem;
  }

  :global(.project-item.is-unfolded) .project-title,
  .project-item:hover .project-title {
    color: var(--amber-rim);
  }

  :global(.project-item.is-unfolded) .project-index,
  .project-item:hover .project-index {
    color: var(--ink-muted);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .tag-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--ink-muted);
    padding: 0.15rem 0.65rem;
    background: rgba(220, 211, 194, 0.45);
    border: 1px solid var(--paper-crease);
    box-shadow: 0 1px 0 var(--paper-highlight);
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  .project-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
  }

  .project-link {
    color: var(--ink-deep);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-bottom: 1px solid var(--paper-crease);
    padding-bottom: 1px;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .project-link:hover {
    color: var(--amber-rim);
    border-bottom-color: var(--amber-rim);
  }

  @media (max-width: 640px) {
    .project-summary,
    .project-drawer {
      margin-left: 0;
    }
  }
</style>
