---
// src/components/ProjectList.astro
// Cursor.com 工业级极简发丝网格与模块化作品卡片
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="projects-section" id="projects">
  <div class="section-eyebrow">
    <span class="label">Craft & Code</span>
    <span class="index">02 / Selected Works</span>
  </div>

  <div class="projects-grid">
    {projects.map((project) => (
      <article class="project-card" data-project={project.data.index}>
        <div class="card-inner">
          <header class="card-header">
            <div class="title-wrap">
              <span class="card-index">{project.data.index}</span>
              <h3 class="card-title">{project.data.title}</h3>
            </div>
            <span class="card-year">{project.data.year}</span>
          </header>

          <p class="card-desc">{project.data.description}</p>

          <div class="card-footer">
            <div class="tag-row">
              {project.data.tags.map((tag) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>

            <div class="action-links">
              {project.data.github && (
                <a class="action-link" href={project.data.github} target="_blank" rel="noopener">
                  <span>GitHub</span>
                  <span class="arrow">↗</span>
                </a>
              )}
              {project.data.demo && (
                <a class="action-link" href={project.data.demo} target="_blank" rel="noopener">
                  <span>Live</span>
                  <span class="arrow">↗</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects-section {
    width: 100%;
  }

  /* 章节眉标 */
  .section-eyebrow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-whisper);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .section-eyebrow .index {
    color: var(--amber-rim);
    font-weight: 500;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  /* Cursor 级模块化极简卡片 */
  .project-card {
    position: relative;
    background: var(--paper-card);
    border: 1px solid var(--border-card);
    border-radius: 8px;
    padding: 1.85rem 2rem;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }

  .project-card:hover {
    background: var(--paper-card-hover);
    border-color: var(--border-focus);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(38, 37, 30, 0.05), 0 2px 6px rgba(38, 37, 30, 0.02);
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .card-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .title-wrap {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .card-index {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--ink-whisper);
    letter-spacing: 0.05em;
  }

  /* 核心标题：Cursor 风格负字距与克制字重 */
  .card-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.65rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--ink-deep);
    line-height: 1.2;
    transition: color 0.25s ease;
  }

  .project-card:hover .card-title {
    color: var(--amber-rim);
  }

  .card-year {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--ink-whisper);
  }

  .card-desc {
    font-family: 'Noto Serif SC', 'Cormorant Garamond', Georgia, serif;
    font-size: 0.96rem;
    color: var(--ink-body);
    line-height: 1.78;
    margin: 0;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-chip {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--ink-muted);
    padding: 0.15rem 0.55rem;
    background: rgba(38, 37, 30, 0.04);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    letter-spacing: 0.02em;
  }

  .action-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .action-link {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--ink-deep);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding-bottom: 1px;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .action-link:hover {
    color: var(--amber-rim);
    border-bottom-color: var(--amber-rim);
  }

  .action-link .arrow {
    font-size: 0.85em;
    transition: transform 0.2s ease;
  }

  .action-link:hover .arrow {
    transform: translate(2px, -2px);
  }
</style>
