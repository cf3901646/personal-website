---
// src/pages/posts/[id].astro
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — 3901646.xyz`}
  description={post.data.description || post.data.title}
>
  <main class="reading-sanctuary">
    <article class="post-spine">
      <!-- 顶部极简返回导航 -->
      <nav class="post-nav">
        <a href="/#garden" class="back-link">← 返回花园目录</a>
        <span class="post-date">{post.data.date}</span>
      </nav>

      <!-- 文章标题与引言 -->
      <header class="post-header">
        <h1 class="post-title">{post.data.title}</h1>
        {post.data.description && (
          <p class="post-summary">{post.data.description}</p>
        )}
        <div class="header-divider" aria-hidden="true"></div>
      </header>

      <!-- Markdown 正文渲染区 -->
      <div class="prose-body">
        <Content />
      </div>

      <!-- 尾部导航与版权 -->
      <footer class="post-footer">
        <div class="post-tags">
          {post.data.tags?.map((tag: string) => (
            <span class="tag-pill">{tag}</span>
          ))}
        </div>
        <Footer />
      </footer>
    </article>
  </main>
</Layout>

<style>
  .reading-sanctuary {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: var(--paper-base);
    display: flex;
    justify-content: center;
    padding: 5rem 1.75rem 8rem;
  }

  .post-spine {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
  }

  .post-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 3.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
  }

  .back-link {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--paper-crease);
    padding-bottom: 1px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .back-link:hover {
    color: var(--amber-rim);
    border-bottom-color: var(--amber-rim);
  }

  .post-date {
    color: var(--ink-whisper);
    letter-spacing: 0.05em;
  }

  .post-header {
    margin-bottom: 2.75rem;
  }

  .post-title {
    font-family: 'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink-deep);
    letter-spacing: 0.01em;
    margin-bottom: 1rem;
  }

  .post-summary {
    font-size: 1.05rem;
    color: var(--ink-muted);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .header-divider {
    width: 100%;
    height: 1px;
    background: var(--paper-crease);
    box-shadow: 0 1px 0 var(--paper-highlight);
  }

  .prose-body {
    font-family: 'Noto Serif SC', 'Cormorant Garamond', Georgia, serif;
    font-size: 1.08rem;
    line-height: 2.05;
    color: var(--ink-body);
  }

  .prose-body :global(p) {
    margin-bottom: 1.85rem;
  }

  .prose-body :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88em;
    background: rgba(220, 211, 194, 0.55);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    color: var(--ink-deep);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3.5rem;
    margin-bottom: 1rem;
  }

  .tag-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--ink-muted);
    padding: 0.15rem 0.65rem;
    background: rgba(220, 211, 194, 0.45);
    border: 1px solid var(--paper-crease);
    box-shadow: 0 1px 0 var(--paper-highlight);
    border-radius: 999px;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .reading-sanctuary {
      padding: 3.5rem 1.25rem 6rem;
    }
  }
</style>
