---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectList from '../components/ProjectList.astro';
import GardenList from '../components/GardenList.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const allPosts = await getCollection('posts');
const publishedPosts = allPosts.filter(p => !p.data.draft);
---

<Layout
  title="3901646.xyz — cf3901646@gmail.com"
  description="3901646.xyz · AI & Tools Digital Garden · cf3901646@gmail.com"
>
  <!-- 幕 I · 高保真摄影级斜阳树影与活字凹印 -->
  <Hero />

  <!-- 幕 II · Cursor / Steph Ango 级极简工程画布 -->
  <main class="content-sanctuary" id="sanctuary-content">
    <div class="reading-spine">

      <!-- 1. 序言：克制的人文科技信条 -->
      <section class="intro-section" id="intro">
        <div class="section-eyebrow">
          <span>Prologue</span>
          <span class="index">01 / Statement</span>
        </div>
        <div class="intro-quote">
          <p class="quote-lead">在代码与界面的缝隙里，造一些有温度的工具。</p>
          <p class="quote-body">探索自主智能体架构、自动化工作流与前沿大模型的交互边界。不作喧闹的喧哗，唯愿秩序与克制长存。</p>
        </div>
        <div class="intro-meta">
          <span class="author">Charlie Freeman</span>
          <span class="dot">/</span>
          <span class="location">Shanghai</span>
          <span class="dot">/</span>
          <a href="https://github.com/cf3901646" target="_blank" rel="noopener" class="meta-link">GitHub ↗</a>
          <span class="dot">/</span>
          <a href="mailto:cf3901646@gmail.com" class="meta-link">Letter ↗</a>
        </div>
      </section>

      <!-- 2. 代表作品 (Cursor 级卡片网格) -->
      <ProjectList projects={sortedProjects} />

      <!-- 3. 数字花园笔记 (安静的书页流) -->
      <GardenList posts={publishedPosts} />

      <!-- 尾注 -->
      <Footer />

    </div>
  </main>
</Layout>

<style>
  .content-sanctuary {
    position: relative;
    width: 100%;
    min-height: 100vh;
    background-color: var(--paper-base);
    display: flex;
    justify-content: center;
    padding: 6rem 1.75rem 10rem;
    z-index: 5;
  }

  /* 黄金阅读跨度 (720px) */
  .reading-spine {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 6rem;
  }

  .intro-section {
    width: 100%;
  }

  .section-eyebrow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-whisper);
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 0.75rem;
  }

  .section-eyebrow .index {
    color: var(--amber-rim);
    font-weight: 500;
  }

  .intro-quote {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .quote-lead {
    font-family: 'Cormorant Garamond', 'Noto Serif SC', Georgia, serif;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink-deep);
    letter-spacing: -0.01em;
    margin: 0;
  }

  .quote-body {
    font-family: 'Noto Serif SC', Georgia, serif;
    font-size: 1.02rem;
    line-height: 1.95;
    color: var(--ink-muted);
    margin: 0;
  }

  .intro-meta {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    color: var(--ink-whisper);
  }

  .dot {
    color: var(--border-focus);
  }

  .meta-link {
    color: var(--ink-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .meta-link:hover {
    color: var(--amber-rim);
    border-bottom-color: var(--amber-rim);
  }

  @media (max-width: 640px) {
    .content-sanctuary {
      padding: 4.5rem 1.25rem 7rem;
    }
    .reading-spine {
      gap: 4.5rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 首屏高保真光影与活字随滚动优雅视差淡出
  const heroSection = document.getElementById('hero');
  const letterpressStage = document.getElementById('letterpress-stage');
  const heroBgPhoto = document.getElementById('hero-bg-img');

  if (heroSection && letterpressStage) {
    ScrollTrigger.create({
      trigger: heroSection,
      start: "top top",
      end: "bottom top",
      scrub: true,
      onUpdate: (self) => {
        const p = self.progress;
        const opacity = Math.max(0, 1 - p * 1.35);
        letterpressStage.style.opacity = String(opacity);
        letterpressStage.style.transform = `translateY(${p * 180}px) scale(${1 - p * 0.04})`;
        if (heroBgPhoto) {
          heroBgPhoto.style.opacity = String(Math.max(0, 1 - p * 1.15));
        }
      }
    });
  }
</script>
